{
  "name": "facturx-vscode",
  "displayName": "Factur-X Viewer",
  "description": "Affiche un PDF Factur-X côte à côte avec son XML embarqué, avec validation de schéma et édition.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:facturx.pdfXmlEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "facturx.pdfXmlEditor",
        "displayName": "Factur-X (PDF + XML)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "facturx.openSideBySide",
        "title": "Factur-X: Ouvrir en vue PDF/XML"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {}
}
