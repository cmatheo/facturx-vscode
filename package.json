{
  "name": "facturx-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "cmatheo",
  "repository": {
    "type": "git",
    "url": "https://github.com/cmatheo/facturx-vscode.git"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "facturx.pdfXmlEditor",
        "displayName": "%facturx.pdfXmlEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "facturx.openInEditor",
        "title": "%command.openInEditor.title%",
        "category": "Factur-X",
        "icon": "$(open-preview)"
      },
      {
        "command": "facturx.showFieldForm",
        "title": "%command.showFieldForm.title%",
        "category": "Factur-X",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "facturx.openInEditor",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "facturx.openInEditor",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc -p ./ --noEmit",
    "build": "node esbuild.js --production",
    "compile": "tsc -p ./ --noEmit && node esbuild.js --production",
    "watch:types": "tsc -w -p ./ --noEmit",
    "watch:build": "node esbuild.js --watch",
    "vscode:prepublish": "npm run compile",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "node scripts/package-vsix.js facturx-vscode.vsix",
    "smoke": "node scripts/smoke-test-bundle.js",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": "eslint --fix",
    "*.{ts,js,mjs,cjs,json,md,css,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289",
    "xmllint-wasm": "^5.3.0"
  }
}
