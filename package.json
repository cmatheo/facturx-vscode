{
  "name": "facturx-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c",
  "l10n": "./l10n",
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "facturx.pdfXmlEditor",
        "displayName": "%facturx.pdfXmlEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "facturx.openInEditor",
        "title": "%command.openInEditor.title%",
        "category": "Factur-X",
        "icon": "$(open-preview)"
      },
      {
        "command": "facturx.showFieldForm",
        "title": "%command.showFieldForm.title%",
        "category": "Factur-X",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "facturx.openInEditor",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "facturx.openInEditor",
          "when": "resourceExtname == .pdf",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "xmllint-wasm": "^5.3.0"
  }
}
