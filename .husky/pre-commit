# Git hooks run under plain `sh`, not the interactive shell that lazy-loads nvm/pnpm
# (oh-my-zsh's nvm plugin, corepack shims, etc.) - so on an nvm-managed Node install,
# `pnpm` isn't necessarily on PATH here even though it works in a normal terminal.
# Only intervene if pnpm isn't already reachable; prefer the .nvmrc-pinned version,
# but fall back to nvm's default alias if that version doesn't have pnpm installed.
if ! command -v pnpm >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    \. "$NVM_DIR/nvm.sh" --no-use
    nvm use >/dev/null 2>&1
    command -v pnpm >/dev/null 2>&1 || nvm use default >/dev/null 2>&1
  fi
fi

pnpm exec lint-staged
pnpm run compile
pnpm test
